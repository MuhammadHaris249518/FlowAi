# Copy to .env for local runs. On Alternate Clouds, set these in the Variables tab.
# Never commit real values.

GROQ_API_KEY=
DEEPGRAM_API_KEY=
# Optional: Groq chat model for intent extraction (default openai/gpt-oss-20b)
GROQ_LLM_MODEL=
# Optional: only used if Groq fails
GEMINI_API_KEY=

# Neon pooled connection string
DATABASE_URL=

# Business data file (default company_data.json; clinic_data.json = original medspa demo)
DATA_FILE=company_data.json

# FlowCRM: its URL ("Open CRM" link on the call page) and the fixed IDs seed_crm.py creates
FLOWCRM_URL=
CRM_ORG_ID=org_coolbreeze
CRM_OWNER_USER_ID=usr_haris

# Owner console (/owner): optional key, then open /owner?key=...
OWNER_CONSOLE_KEY=

# Handoff channels (optional; the owner console always works)
# Telegram: create a bot with @BotFather, send /start to it -> it replies with your chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
# polling (default, no webhook needed) | webhook (uses TELEGRAM_WEBHOOK_SECRET) | off
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=
HANDOFF_TIMEOUT_SECONDS=45

# ---- FlowCRM service (flowcrm/Dockerfile) ----
# DATABASE_URL: same Neon pooled string, without "&channel_binding=require"
# DIRECT_URL:   same string without "-pooler" in the host (Prisma needs both)
DIRECT_URL=
AUTH_MODE=demo
DEMO_CLERK_ID=demo_haris
DEMO_ORG_ID=org_coolbreeze
