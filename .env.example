# Copy to .env for local runs. On Alternate Clouds, set these in the Variables tab.
# Never commit real values.

GROQ_API_KEY=
DEEPGRAM_API_KEY=
# Optional: Groq chat model for intent extraction (default openai/gpt-oss-20b)
GROQ_LLM_MODEL=
# Optional: only used if Groq fails
GEMINI_API_KEY=

# Neon pooled connection string
DATABASE_URL=

# Business data file (clinic_data.json now, company_data.json after the niche switch)
DATA_FILE=clinic_data.json

# FlowCRM link: seed_crm.py creates these fixed IDs
CRM_ORG_ID=org_coolbreeze
CRM_OWNER_USER_ID=usr_ahmed

# Phase 7+ (Telegram handoff)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=
HANDOFF_TIMEOUT_SECONDS=45

# ---- FlowCRM service (flowcrm/Dockerfile) ----
# DATABASE_URL: same Neon pooled string, without "&channel_binding=require"
# DIRECT_URL:   same string without "-pooler" in the host (Prisma needs both)
DIRECT_URL=
AUTH_MODE=demo
DEMO_CLERK_ID=demo_ahmed
DEMO_ORG_ID=org_coolbreeze
