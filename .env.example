# Copy to .env for local runs. On Alternate Clouds, set these in the Variables tab.
# Never commit real values.

GROQ_API_KEY=
DEEPGRAM_API_KEY=
# Optional: Groq chat model for intent extraction (default openai/gpt-oss-20b)
GROQ_LLM_MODEL=
# Optional: only used if Groq fails
GEMINI_API_KEY=

# Neon pooled connection string
DATABASE_URL=

# Business data file (clinic_data.json now, company_data.json after the niche switch)
DATA_FILE=clinic_data.json

# Phase 7+ (Telegram handoff)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=
HANDOFF_TIMEOUT_SECONDS=45
